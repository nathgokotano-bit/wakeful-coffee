<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MANU Coffee</title>

<!-- Keep this page out of Google and other search engines -->
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex">

<meta name="theme-color" content="#FFFFFF">
<link rel="icon" type="image/jpeg" href="data:image/jpeg;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&display=swap" rel="stylesheet">

<style>
:root{
  --page:#FFFFFF;        /* outer background (sampled from your Framer design) */
  --card:#735847;        /* parent card */
  --btn:#FFFFFF;         /* link buttons */
  --btn-hover:#F1EBE6;
  --logo-bg:#FFFFFF;     /* circle behind the logo */
  --ink:#000;            /* title + description on the card. For better contrast try #fff */
  --btn-ink:#000;        /* button labels + icons */
  --gap:16px;            /* space between card and screen edge */
  --align:flex-start;    /* flex-start = content at top (as designed) · center = vertically centered */
}
*{box-sizing:border-box;margin:0}
html{-webkit-text-size-adjust:100%}
body{
  min-height:100vh;min-height:100dvh;           /* follows the real visible viewport on any phone */
  display:flex;justify-content:center;
  padding:max(var(--gap),env(safe-area-inset-top)) max(var(--gap),env(safe-area-inset-right)) max(var(--gap),env(safe-area-inset-bottom)) max(var(--gap),env(safe-area-inset-left));
  background:var(--page);color:var(--ink);
  font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
/* Parent: stretches to the full viewport height. Children sit inside it. */
.card{
  flex:1;max-width:520px;
  display:flex;flex-direction:column;align-items:center;justify-content:var(--align);
  padding:clamp(28px,5dvh,52px) 20px 28px;
  background:var(--card);border-radius:28px;
}
.logo{
  width:clamp(76px,22vw,92px);aspect-ratio:1;flex:none;
  border-radius:50%;overflow:hidden;background:var(--logo-bg);
}
.logo img{display:block;width:100%;height:100%;object-fit:cover}
h1{font-size:clamp(16px,4.6vw,18px);font-weight:700;line-height:1.1;margin:14px 0 8px;text-align:center}
.about{font-size:clamp(13px,3.9vw,15.5px);line-height:1.25;text-align:center;font-weight:400}
.about span{display:block;max-width:21em;margin:0 auto}
.links{width:100%;display:grid;gap:12px;margin-top:clamp(16px,3dvh,24px)}
.link{
  display:grid;grid-template-columns:28px 1fr 28px;align-items:center;
  min-height:54px;padding:0 14px;border-radius:14px;
  background:var(--btn);color:var(--btn-ink);text-decoration:none;
  font-size:16px;font-weight:700;text-align:center;
  -webkit-tap-highlight-color:transparent;transition:background .15s,transform .15s;
}
.link span{grid-column:2;grid-row:1}
.link:hover{background:var(--btn-hover)}
.link:active{transform:scale(.98)}
.link:focus-visible{outline:3px solid #fff;outline-offset:2px}
.link svg{grid-column:1;grid-row:1;width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
@media (prefers-reduced-motion:reduce){.link{transition:none}}
</style>
</head>
<body>
<main class="card">
  <div class="logo"><img alt="MANU Coffee logo" width="320" height="320" src="data:image/jpeg;base64,"></div>
  <h1>MANU Coffee</h1>
  <p class="about">
    <span>Coffee • Matcha • Hojicha • Eats Good Coffee, Good People</span>
    <span>7 AM - 10 PM</span>
  </p>

  <nav class="links" aria-label="MANU Coffee social media">
    <!-- Google Review button (add your review link, then remove the comment markers)
    <a class="link" href="PASTE-GOOGLE-REVIEW-LINK" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 12.2H12M20.3 12.2A8.5 8.5 0 1 1 17.8 6"/></svg>
      <span>Google Review</span>
    </a>
    -->
    <a class="link" href="https://web.facebook.com/manucoffeeph/?_rdc=1&amp;_rdr#" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21.5v-8.2h2.8l.5-3.3h-3.3V7.9c0-1 .5-1.7 1.8-1.7h1.6V3.3c-.4-.1-1.4-.2-2.4-.2-2.5 0-4 1.5-4 4.2V10H7.7v3.3h2.8v8.2z"/></svg>
      <span>Facebook</span>
    </a>
    <a class="link" href="https://www.instagram.com/manucoffeeph/" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".7"/></svg>
      <span>Instagram</span>
    </a>
    <a class="link" href="https://www.tiktok.com/@munacafedavao" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 3.5v11a3.8 3.8 0 1 1-3.8-3.8"/><path d="M14.5 3.5c.3 2.5 2 4.2 4.5 4.4"/></svg>
      <span>TikTok</span>
    </a>
  </nav>
</main>
</body>
</html>