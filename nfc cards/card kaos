<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kaos Cafe</title>

<!-- Keep this page out of Google and other search engines -->
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
<meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex">

<meta name="theme-color" content="#1A1112">
<link rel="icon" type="image/jpeg" href="data:image/jpeg;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&display=swap" rel="stylesheet">

<style>
:root{
  --page:#1A1112;        /* outer background */
  --card:#60111A;        /* parent card */
  --btn:#211617;         /* link buttons */
  --btn-hover:#2E1F20;
  --gap:16px;            /* space between card and screen edge */
  --align:flex-start;    /* flex-start = content at top (as designed) · center = vertically centered */
}
*{box-sizing:border-box;margin:0}
html{-webkit-text-size-adjust:100%}
body{
  min-height:100vh;min-height:100dvh;           /* follows the real visible viewport on any phone */
  display:flex;justify-content:center;
  padding:max(var(--gap),env(safe-area-inset-top)) max(var(--gap),env(safe-area-inset-right)) max(var(--gap),env(safe-area-inset-bottom)) max(var(--gap),env(safe-area-inset-left));
  background:var(--page);color:#fff;
  font-family:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
/* Parent: stretches to the full viewport height. Children sit inside it. */
.card{
  flex:1;max-width:520px;
  display:flex;flex-direction:column;align-items:center;justify-content:var(--align);
  padding:clamp(28px,6dvh,56px) 20px 28px;
  background:var(--card);border-radius:28px;
}
.logo{
  width:clamp(76px,22vw,96px);aspect-ratio:1;flex:none;
  border-radius:50%;overflow:hidden;background:#fff;
}
.logo img{display:block;width:100%;height:100%;object-fit:cover}
h1{font-size:clamp(17px,5vw,20px);font-weight:700;line-height:1.1;margin:14px 0 6px;text-align:center}
.about{font-size:clamp(12px,3.5vw,14px);line-height:1.3;text-align:center;font-weight:400}
.about span{display:block}
.links{width:100%;display:grid;gap:12px;margin-top:clamp(18px,3.5dvh,26px)}
.link{
  display:grid;grid-template-columns:28px 1fr 28px;align-items:center;
  min-height:56px;padding:0 16px;border-radius:16px;
  background:var(--btn);color:#fff;text-decoration:none;
  font-size:16px;font-weight:700;text-align:center;
  -webkit-tap-highlight-color:transparent;transition:background .15s,transform .15s;
}
.link span{grid-column:2}
.link:hover{background:var(--btn-hover)}
.link:active{transform:scale(.98)}
.link:focus-visible{outline:3px solid #fff;outline-offset:2px}
.link svg{grid-column:1;grid-row:1;width:24px;height:24px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.link span{grid-row:1}
@media (prefers-reduced-motion:reduce){.link{transition:none}}
</style>
</head>
<body>
<main class="card">
  <div class="logo"><img alt="Kaos Cafe logo" width="320" height="320" src="data:image/jpeg;base64,"></div>
  <h1>Kaos Cafe</h1>
  <p class="about">
    <span>/ˈkeɪ.ɑːs/ • Open Anytime</span>
    <span>Jacinto st.</span>
  </p>

  <nav class="links" aria-label="Kaos Cafe links">
    <a class="link" href="https://web.facebook.com/kaosdvo/?_rdc=1&amp;_rdr#" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21.5v-8.2h2.8l.5-3.3h-3.3V7.9c0-1 .5-1.7 1.8-1.7h1.6V3.3c-.4-.1-1.4-.2-2.4-.2-2.5 0-4 1.5-4 4.2V10H7.7v3.3h2.8v8.2z"/></svg>
      <span>Facebook</span>
    </a>
    <a class="link" href="https://www.instagram.com/kaosdvo/?hl=en" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".7"/></svg>
      <span>Instagram</span>
    </a>
    <a class="link" href="https://drive.google.com/file/d/1jLtNaDIqxGa6Gb_x9F-SDj2Y4zt3DvY8/view" target="_blank" rel="noopener noreferrer">
      <span>KAOS MENU</span>
    </a>
  </nav>
</main>
</body>
</html>